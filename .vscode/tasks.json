{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run active OpenMP or MPI file",
      "type": "process",
      "command": "${env:ComSpec}",
      "args": ["/d", "/c", "call", "${workspaceFolder}\\.vscode\\run-active.cmd", "${file}"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile",
      "presentation": { "reveal": "always", "clear": true }
    }
  ]
}
